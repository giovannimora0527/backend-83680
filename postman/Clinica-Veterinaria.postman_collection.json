{
  "info": {
    "_postman_id": "2c1c7de1-a8a1-4b7d-9896-fb2b1c028d21",
    "name": "Clínica Veterinaria - Citas e historias",
    "description": "Colección ajustada al esquema MySQL de la clínica.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/clinica/v1" },
    { "key": "clienteId", "value": "1" },
    { "key": "mascotaId", "value": "1" },
    { "key": "pacienteId", "value": "1" },
    { "key": "medicoId", "value": "3" },
    { "key": "citaId", "value": "1" },
    { "key": "historiaMedicaId", "value": "1" },
    { "key": "anotacionHistoriaId", "value": "1" },
    { "key": "fechaInicial", "value": "2024-01-01T00:00:00" },
    { "key": "fechaFinal", "value": "2026-12-31T23:59:59" }
  ],
  "item": [
    {
      "name": "Fórmulas médicas",
      "item": [
        {
          "name": "Listar fórmulas (fecha_creacion_registro DESC)",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/formula-medica/listar" }
        }
      ]
    },
    {
      "name": "Citas",
      "item": [
        {
          "name": "Crear cita",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"mascotaId\": {{mascotaId}},\n  \"medicoId\": {{medicoId}},\n  \"fechaHora\": \"2026-10-15T10:30:00\",\n  \"estado\": \"programada\",\n  \"motivo\": \"Consulta general\"\n}"
            },
            "url": "{{baseUrl}}/cita/guardar"
          }
        },
        {
          "name": "Listar citas por fecha_hora (DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cita/listar?fechaInicial={{fechaInicial}}&fechaFinal={{fechaFinal}}"
          }
        },
        {
          "name": "Actualizar cita",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"citaId\": {{citaId}},\n  \"clienteId\": {{clienteId}},\n  \"mascotaId\": {{mascotaId}},\n  \"medicoId\": {{medicoId}},\n  \"fechaHora\": \"2026-10-15T11:00:00\",\n  \"estado\": \"programada\",\n  \"motivo\": \"Consulta general actualizada\"\n}"
            },
            "url": "{{baseUrl}}/cita/actualizar"
          }
        }
      ]
    },
    {
      "name": "Historias médicas",
      "item": [
        {
          "name": "Crear historia médica",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": {{pacienteId}}\n}"
            },
            "url": "{{baseUrl}}/historia-medica/guardar"
          }
        },
        {
          "name": "Listar historias médicas (fecha_creacion DESC)",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/historia-medica/listar" }
        },
        {
          "name": "Actualizar historia médica",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"historiaMedicaId\": {{historiaMedicaId}},\n  \"pacienteId\": {{pacienteId}}\n}"
            },
            "url": "{{baseUrl}}/historia-medica/actualizar"
          }
        },
        {
          "name": "Eliminar historia médica",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/historia-medica/eliminar?historiaMedicaId={{historiaMedicaId}}"
          }
        }
      ]
    },
    {
      "name": "Anotaciones de historia médica",
      "item": [
        {
          "name": "Crear anotación",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"historiaMedicaId\": {{historiaMedicaId}},\n  \"medicoId\": {{medicoId}},\n  \"descripcion\": \"Paciente estable. Se recomienda control en 15 días.\"\n}"
            },
            "url": "{{baseUrl}}/anotacion-historia/guardar"
          }
        },
        {
          "name": "Listar anotaciones por fecha (DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/anotacion-historia/listar?fechaInicial={{fechaInicial}}&fechaFinal={{fechaFinal}}"
          }
        },
        {
          "name": "Actualizar anotación",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"anotacionHistoriaId\": {{anotacionHistoriaId}},\n  \"historiaMedicaId\": {{historiaMedicaId}},\n  \"medicoId\": {{medicoId}},\n  \"descripcion\": \"Paciente estable; control programado dentro de 15 días.\"\n}"
            },
            "url": "{{baseUrl}}/anotacion-historia/actualizar"
          }
        }
      ]
    }
  ]
}
